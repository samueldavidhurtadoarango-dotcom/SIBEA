{
    "name": "benefitrack/aplicacion",
    "description": "BenefitRack: gestión de beneficios para aprendices del SENA",
    "type": "project",
    "require": {
        "php": "^8.2",
        "phpoffice/phpspreadsheet": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": { "BenefitRack\\": "src/" },
        "files": ["src/Nucleo/funciones.php"]
    },
    "autoload-dev": {
        "psr-4": { "BenefitRack\\Pruebas\\": "pruebas/" }
    },
    "scripts": {
        "pruebas": "phpunit",
        "analisis": [
            "phpstan analyse --memory-limit=512M",
            "@php herramientas/revisar_comentarios.php"
        ],
        "formato": "php-cs-fixer fix --diff"
    },
    "config": {
        "sort-packages": true
    }
}
